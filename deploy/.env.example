# deploy/.env — 배포용 (이 파일을 복사해 deploy/.env 로 채우세요. 실제 키 커밋 금지)
# ⚠️ 테스트넷 전용 키만 사용. 메인넷/실자금 키 재사용 금지.

# 배포자 개인키 (가스용 Base Sepolia ETH 보유한 지갑)
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY

# RPC (공용 또는 Alchemy/Infura Base Sepolia)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# 트레저리/서명자 주소 (미설정 시 배포자 주소 사용)
# SIGNER_ADDRESS 는 서버 SIGNER_PRIVATE_KEY 의 주소와 동일해야 함(출금 서명 검증)
TREASURY_ADDRESS=
SIGNER_ADDRESS=

# 기존 USDC 토큰 주소 (설정 시 MockTestUSDC 안 만들고 그 토큰 사용 — 메인넷용)
USDC_ADDRESS=

# Basescan API 키 (verify 용, 선택)
BASESCAN_API_KEY=
