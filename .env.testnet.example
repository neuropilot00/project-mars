# ──────────────────────────────────────────────────────────────────────────
# OCCUPY MARS — Base Sepolia(테스트넷) 체인 연결 env 템플릿
# 사용법: 이 값들을 server/.env 에 채워 넣으세요. (이 파일은 예시 — 실제 키/주소 넣지 말 것)
# 자세한 절차: docs/BASE_TESTNET_RUNBOOK.md
# ⚠️ SIGNER_PRIVATE_KEY 등 비밀값은 절대 git/평문 노출 금지 (시크릿 매니저/KMS 권장)
# ──────────────────────────────────────────────────────────────────────────

# ── Base Sepolia 체인 ──
# chainId: Base Sepolia = 84532 (mainnet 전환 시 8453 또는 변수 삭제). 출금 서명 해시에 포함되므로 컨트랙트 배포 체인과 반드시 일치.
BASE_CHAIN_ID=84532
# RPC: 공용 https://sepolia.base.org 또는 Alchemy/Infura Base Sepolia 엔드포인트(권장)
BASE_RPC_URL=https://sepolia.base.org
# 배포한 MarsDeposit 컨트랙트 주소 (contracts/MarsDeposit.sol)
BASE_DEPOSIT_ADDRESS=0xYOUR_DEPLOYED_MARSDEPOSIT_CONTRACT
# 출금 승인 서명자 개인키 — 이 키의 주소가 컨트랙트의 signer 와 동일해야 함
SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_PRIVATE_KEY
# (선택) 트레저리 주소 — 컨트랙트 배포 생성자 인자용(서버는 직접 사용 안 함)
TREASURY_ADDRESS=0xYOUR_TREASURY

# ── 입금 리스너 백필 튜닝(선택) ──
# 입금 이력 0일 때 cold-start 로 최근 N블록만 스캔. 워커 다운 대비 넉넉히.
BACKFILL_BLOCKS=5000
BACKFILL_CHUNK=5000

# ── (참고) 다른 체인도 같은 패턴 ──
# BNB_CHAIN_ID=97   # BNB testnet
# ETH_CHAIN_ID=11155111  # Sepolia
# BNB_RPC_URL=...   BNB_DEPOSIT_ADDRESS=0x...
# ETH_RPC_URL=...   ETH_DEPOSIT_ADDRESS=0x...

# ── 표준 서버 env (별도 설정 — 여기 키 외에도 필요) ──
# DATABASE_URL=postgresql://...
# JWT_SECRET=...
# ADMIN_SECRET=...
# REDIS_URL=...            # 멀티 인스턴스 시
# RUN_SCHEDULERS=true      # 입금 리스너는 리더/워커 인스턴스에서만 (멀티 인스턴스)
