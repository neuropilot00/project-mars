# ── Base Sepolia 테스트넷 env 템플릿 ──
# 실제 값으로 채운 뒤 server/.env 로 복사해 사용. 키/시크릿은 절대 커밋 금지.
# 자세한 절차는 docs/BASE_TESTNET_RUNBOOK.md 참고.

NODE_ENV=development
DATABASE_URL=postgresql://jongho@localhost:5432/pixelwar
PORT=3000

# 강력한 랜덤값으로 교체
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Base Sepolia 테스트넷 (chainId 84532) ──
# ⚠️ signer.js 의 base.chainId 가 8453(메인넷) 하드코딩 → 테스트넷에선 84532 로 맞춰야
#    출금 서명이 컨트랙트에서 검증됨 (RUNBOOK §2 참고).
BASE_RPC_URL=https://sepolia.base.org
BASE_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000   # 배포한 MarsDeposit 주소
SIGNER_PRIVATE_KEY=0x_테스트_서명자_개인키                          # 컨트랙트 signer 와 동일 주소
TREASURY_ADDRESS=0x_트레저리_지갑

# (선택) env 기반 chainId 오버라이드를 코드에 추가했다면:
# BASE_CHAIN_ID=84532

# 테스트넷에선 다른 체인은 비활성(주소 0x0 유지)
BNB_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000
ETH_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000

# CORS — 로컬 테스트
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
