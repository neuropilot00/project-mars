# ── Environment ──
NODE_ENV=production

# ── Database (REQUIRED) ──
DATABASE_URL=postgresql://user:password@localhost:5432/pixelwar

# ── Server ──
PORT=3000

# ── Auth (REQUIRED — must be strong, random secrets in production) ──
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Blockchain ──
# 출금 승인 서명 키 — 이 키의 주소가 배포한 MarsDeposit 컨트랙트의 signer 와 같아야 함.
SIGNER_PRIVATE_KEY=0x_your_server_signing_private_key
TREASURY_ADDRESS=0x_your_treasury_wallet
# 커스터디 지갑 암호화 마스터키(REQUIRED — 유저 자동지갑 키 AES-256-GCM 암호화).
#   미설정 시 커스터디 지갑 생성 비활성. 생성: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
# (선택) Base 체인 ID — 기본 8453(메인넷). 테스트넷(Base Sepolia)이면 84532.
# BASE_CHAIN_ID=8453

# ── RPC Endpoints ──
BASE_RPC_URL=https://mainnet.base.org
BNB_RPC_URL=https://bsc-dataseed.binance.org
ETH_RPC_URL=https://eth.llamarpc.com

# ── Deployed MarsDeposit Contract Addresses ──
BASE_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000
BNB_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000
ETH_DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Email (SMTP) — required for password reset emails ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ── CORS ──
ALLOWED_ORIGINS=https://yourdomain.com
