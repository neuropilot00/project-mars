      "title": {
        "ko": "광산 패권 다툼",
        "en": "Mine Supremacy Fight"
      },
      "subtitle": {
        "ko": "Kepler 갱도 — CV 내부 충돌",
        "en": "Kepler Shaft — CV Internal Conflict"
      }
    },
    {
      "id": "s_result",
      "type": "result",
      "success_scene": "s_success",
      "failure_scene": "s_fail"
