          "preview_hint": { "ko": "→ 케nji 생존, 가족 협상 가능성", "en": "→ Kenji survives, family negotiation possible" }
        },
        {
          "id": "fsp_ch6_accuse_wrong",
          "text": { "ko": "다른 인물 지목.", "en": "Accuse a different person." },
          "tone": "manipulative",
          "preview_hint": { "ko": "→ 내부 불신 폭발, 케nji 감사", "en": "→ Internal distrust explodes, Kenji grateful" }
        }
      ]
    },
    {
      "id": "s06",
      "type": "dialogue",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "mikhail", "emotion": "heavy", "text": { "ko": "가족을 지키려 한 거야. 방법이 잘못됐을 뿐이지.", "en": "He was trying to protect his family. The method was wrong." } },
        { "speaker": "amara", "emotion": "conflicted", "text": { "ko": "...그걸 알면서도 결정해야 해요.", "en": "...Knowing that doesn't change what we have to decide." } }
      ]
