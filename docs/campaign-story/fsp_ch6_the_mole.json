    {
      "id": "s_ending",
      "type": "ending",
      "background": "mars_sunset",
      "bgm": "ambient_melancholy",
      "transition": "fade_slow",
      "lines": [
        { "text": { "ko": "가장 오래된 전쟁은 내부에서 온다. 배신은 적의 얼굴을 하지 않는다. 알고 있는 사람의 얼굴을 한다. 그래서 더 오래, 더 깊이 남는다.", "en": "The oldest wars come from within. Betrayal doesn't wear an enemy's face. It wears the face of someone you know. That's why it stays longer. Deeper." } }
      ],
      "next_chapter_preview": { "questId": "fsp_campaign_ch7", "teaser": { "ko": "다음 — 의회", "en": "Next — The Parliament" } }
