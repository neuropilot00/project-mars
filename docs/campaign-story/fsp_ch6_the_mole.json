      "background": "hellas_mining_outpost",
      "bgm": "choice_tension",
      "prompt": { "ko": "케nji 타나카를 어떻게 처리하겠습니까?", "en": "How do you handle Kenji Tanaka?" },
      "choices": [
        {
          "id": "fsp_ch6_execute_kenji",
          "text": { "ko": "처형.", "en": "Execute him." },
