  "scenes": [
    {
      "id": "s01",
      "type": "narration",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "fade_slow",
      "lines": [
        { "text": { "ko": "누군가 내부에서 FSP 이동 경로를 MCC에 팔고 있었다. 세 번의 작전이 타이밍이 너무 정확했다. 우연이 세 번 겹치는 경우는 없다.", "en": "Someone inside was selling FSP movement routes to MCC. Three operations, the timing too precise. Coincidence doesn't happen three times in a row." } }
      ]
    },
    {
      "id": "s02",
      "type": "dialogue",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "amara", "emotion": "tense", "effect": "character_enter:amara:slide_right", "text": { "ko": "케nji 타나카. 물류팀. 그의 가족이 MCC 영토 안에 있어요. 뉴 서울 정착지.", "en": "Kenji Tanaka. Logistics team. His family is inside MCC territory. New Seoul settlement." } },
        { "speaker": "mikhail", "emotion": "controlled", "effect": "character_enter:mikhail:slide_left", "text": { "ko": "증거?", "en": "Evidence?" } },
        { "speaker": "amara", "emotion": "certain", "text": { "ko": "통신 패턴 세 건. 암호화된 단파. 발신지 그의 구역.", "en": "Three communication patterns. Encrypted shortwave. Origin point, his sector." } }
      ]
    },
    {
      "id": "s03",
      "type": "dialogue",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "mikhail", "emotion": "tired", "text": { "ko": "가족이 인질이면 다른 선택이 없었겠지.", "en": "If his family's a hostage, he didn't have another choice." } },
        { "speaker": "amara", "emotion": "firm", "text": { "ko": "그래도 우리 사람들이 그 정보 때문에 죽었어요.", "en": "Our people still died because of that information." } },
        { "speaker": "mikhail", "emotion": "quiet", "text": { "ko": "...", "en": "..." } }
      ]
    },
    {
      "id": "s04",
      "type": "narration",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "text": { "ko": "케nji가 방 안으로 들어왔을 때 그는 이미 알고 있었다. 눈이 그것을 말했다. 도망치지도 않았다.", "en": "When Kenji came into the room, he already knew. His eyes said it. He didn't run." } }
      ]
    },
    {
      "id": "s05",
      "type": "dialogue",
      "background": "hellas_mining_outpost",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "amara", "emotion": "cold", "text": { "ko": "설명할 기회 드리죠.", "en": "I'll give you a chance to explain." } },
        { "speaker": "player", "emotion": "neutral", "text": { "ko": "케nji. 가족 이야기부터 해요.", "en": "Kenji. Tell us about your family first." } },
        { "speaker": "mikhail", "emotion": "gentle", "text": { "ko": "뉴 서울에 누가 있어요?", "en": "Who's in New Seoul?" } }
      ]
    },
    {
