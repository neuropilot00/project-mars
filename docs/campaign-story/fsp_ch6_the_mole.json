        { "speaker": "amara", "emotion": "relieved", "effect": "character_enter:amara:slide_right", "text": { "ko": "헬라스 방어선 유지. MCC 철수했어요.", "en": "Hellas line held. MCC withdrew." } },
        { "speaker": "mikhail", "emotion": "weary", "effect": "character_enter:mikhail:slide_left", "text": { "ko": "내부 문제가 외부 공격보다 오래 남아.", "en": "Internal wounds last longer than external attacks." } }
