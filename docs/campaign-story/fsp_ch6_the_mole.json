        { "speaker": "amara", "emotion": "devastated", "effect": "character_enter:amara:slide_right", "text": { "ko": "헬라스 외곽 구역 세 곳 점령 당했어요.", "en": "Three outer sectors of Hellas taken." } },
        { "speaker": "mikhail", "emotion": "grim", "effect": "character_enter:mikhail:slide_left", "text": { "ko": "신뢰는 한 번 잃으면 되찾기 어려워.", "en": "Trust, once lost, is hard to rebuild." } }
