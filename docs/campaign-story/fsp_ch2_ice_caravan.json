      "bgm": "victory_calm",
      "lines": [
        { "speaker": "lena", "emotion": "warm", "effect": "character_enter:lena:slide_right", "text": { "ko": "17시간 48분. 기록이에요.", "en": "Seventeen hours and forty-eight minutes. That's a record." } },
        { "speaker": "mikhail", "emotion": "warm", "effect": "character_enter:mikhail:slide_left", "text": { "ko": "얼음 손실 12%. 충분해요.", "en": "Twelve percent melt. That's enough." } }
      ]
    },
    {
      "id": "s_fail",
      "type": "dialogue",
      "background": "hellas_mining_outpost",
      "bgm": "defeat_ambient",
      "lines": [
        { "speaker": "mikhail", "emotion": "tired", "effect": "character_enter:mikhail:slide_left", "text": { "ko": "800킬로톤에서 400. 정착지 두 달치 물이 사라졌어요.", "en": "Eight hundred kilotons to four hundred. Two months of settlement water, gone." } },
        { "speaker": "lena", "emotion": "grim", "effect": "character_enter:lena:slide_right", "text": { "ko": "CV는 얼음도 사람도 가리지 않아요.", "en": "CV doesn't distinguish between ice and people." } }
      ]
    },
    {
      "id": "s_ending",
      "type": "ending",
      "background": "mars_sunset",
      "bgm": "ambient_melancholy",
      "transition": "fade_slow",
      "lines": [
        { "text": { "ko": "화성의 물은 전부 다른 곳에서 왔다. 극관에서, 소행성에서, 아니면 누군가의 등뼈에서. 어느 쪽이든 값이 비싸다.", "en": "All the water on Mars came from somewhere else. The poles. Asteroids. Or someone's backbone. Either way it costs." } }
      ],
      "next_chapter_preview": { "questId": "fsp_campaign_ch3", "teaser": { "ko": "다음 — 피의 광산", "en": "Next — Blood Mine" } }
    }
  ]
