    {
      "id": "s_fail",
      "type": "dialogue",
      "background": "kepler_crater",
      "bgm": "defeat_ambient",
      "lines": [
        { "speaker": "cinder", "emotion": "tense", "effect": "character_enter:cinder:slide_right", "text": { "ko": "FSP 증원이 왔어. 빠져나가야 해.", "en": "FSP reinforcements came. We need to pull back." } }
      ]
