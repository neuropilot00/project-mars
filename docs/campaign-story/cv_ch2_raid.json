      "bgm": "victory_calm",
      "lines": [
        { "speaker": "butcher", "emotion": "flat", "effect": "character_enter:butcher:slide_left", "text": { "ko": "물자 확보. 이번 달은 버텨.", "en": "Supplies secured. We make it through this month." } }
      ]
