    {
      "id": "s01",
      "type": "narration",
      "background": "mcc_briefing_room",
      "bgm": "cv_ambient_dark",
      "transition": "fade_slow",
      "lines": [
        { "text": { "ko": "얼음 호송선이 새벽 3시에 지나간다.\nFSP 마크. 의료 물자와 식량.\nCV는 배고팠다. 항상 그랬다.", "en": "The ice convoy passes at 3 AM.\nFSP markings. Medical supplies and food.\nCV was hungry. Always was." } }
      ]
    },
    {
      "id": "s02",
      "type": "dialogue",
      "background": "mcc_briefing_room",
      "bgm": "cv_ambient_dark",
      "transition": "cut",
      "lines": [
        { "speaker": "butcher", "emotion": "flat", "effect": "character_enter:butcher:slide_left", "text": { "ko": "호송선 4대. 얼음 200톤. 우리가 먹어야 할 것들이야.\n셋이 가고 하나를 남겨. 의료 차량이 어디 있는지 봐.", "en": "Four convoy vehicles. Two hundred tons of ice. Things we need to eat.\nTake three and leave one. See which one is medical." } },
        { "speaker": "cinder", "emotion": "cautious", "effect": "character_enter:cinder:slide_right", "text": { "ko": "환자가 있을 수 있어.", "en": "There could be patients." } },
        { "speaker": "butcher", "emotion": "cold", "text": { "ko": "알아.", "en": "I know." } }
      ]
    },
    {
      "id": "s03",
      "type": "narration",
      "background": "mcc_briefing_room",
      "bgm": "cv_ambient_dark",
      "transition": "cut",
      "lines": [
        { "text": { "ko": "차가운 바위 뒤에서 기다렸다.\n호송선의 엔진 소리가 먼저 들렸다.\n그다음에 불빛이 보였다.", "en": "You waited behind cold rocks.\nThe engine sounds came first.\nThen the lights." } }
      ]
    },
    {
      "id": "s_choice",
      "type": "choice",
      "background": "kepler_crater",
      "bgm": "choice_tension",
      "prompt": { "ko": "어떻게 습격하겠습니까?", "en": "How do you conduct the raid?" },
      "choices": [
        {
          "id": "cv_ch2_full_raid",
          "text": { "ko": "전면 약탈. 모두 가져간다.", "en": "Full raid. Take everything." },
          "tone": "ruthless",
          "preview_hint": { "ko": "→ CV +15, FSP -20, 의료 물자도 포함", "en": "→ CV +15, FSP -20, includes medical supplies" }
        },
        {
          "id": "cv_ch2_selective",
          "text": { "ko": "절반만. 의료 호송은 건드리지 않는다.", "en": "Take half. Leave the medical convoy." },
          "tone": "measured",
          "preview_hint": { "ko": "→ CV +5, FSP -5, 신더의 동의", "en": "→ CV +5, FSP -5, Cinder approves" }
        },
        {
          "id": "cv_ch2_abort",
          "text": { "ko": "환자가 있다. 철수한다.", "en": "There are patients. Abort." },
          "tone": "merciful",
          "preview_hint": { "ko": "→ CV -10, FSP +5, 정육점 실망", "en": "→ CV -10, FSP +5, Butcher disappointed" }
        },
        {
          "id": "cv_ch2_negotiate",
          "text": { "ko": "공격 대신 통행세를 요구한다.", "en": "Demand a toll instead of attacking." },
          "tone": "pragmatic",
          "preview_hint": { "ko": "→ CV +8, 신더 루트 강화", "en": "→ CV +8, Cinder route strengthened" }
        }
      ]
    },
    {
      "id": "s04",
      "type": "dialogue",
      "background": "kepler_crater",
      "bgm": "cv_ambient_dark",
      "transition": "cut",
      "lines": [
        { "speaker": "cinder", "emotion": "neutral", "effect": "character_enter:cinder:slide_right", "text": { "ko": "끝났어. 물자는 기지로 가.", "en": "Done. Supplies go to base." } },
        { "speaker": "butcher", "emotion": "flat", "effect": "character_enter:butcher:slide_left", "text": { "ko": "잘했어. 이게 생존이야.", "en": "Good. That's survival." } }
      ]
    },
