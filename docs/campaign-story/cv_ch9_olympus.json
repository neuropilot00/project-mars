      "lines": [
        { "speaker": "butcher", "emotion": "alive", "effect": "character_enter:butcher:slide_left", "text": { "ko": "살아있어. 당신도.", "en": "Alive. You too." } },
        { "speaker": "hale", "emotion": "soft", "effect": "character_enter:hale:slide_right", "text": { "ko": "이제 마지막이야.", "en": "Now it's the end." } }
