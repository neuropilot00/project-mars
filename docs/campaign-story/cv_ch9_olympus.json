      "background": "mcc_25deg_lounge",
      "bgm": "choice_tension",
      "prompt": { "ko": "Olympus 정상에서 무엇을 지키겠습니까?", "en": "What do you protect on Olympus?" },
      "choices": [
        {
          "id": "cv_ch9_protect_butcher",
          "text": { "ko": "정육점을 보호한다.", "en": "Protect Butcher." },
          "tone": "loyal",
          "preview_hint": { "ko": "→ 정육점 루트 생존, 전쟁 계속", "en": "→ Butcher route survives, war continues" }
        },
        {
          "id": "cv_ch9_protect_cinder",
          "text": { "ko": "신더를 보호한다.", "en": "Protect Cinder." },
          "tone": "future",
          "preview_hint": { "ko": "→ 신더 루트 강화, 정육점 위험", "en": "→ Cinder route strengthened, Butcher at risk" }
        },
        {
          "id": "cv_ch9_protect_summit",
          "text": { "ko": "회담 자체를 보호한다. 전원 탈출.", "en": "Protect the summit itself. Everyone evacuates." },
          "tone": "pragmatic",
          "preview_hint": { "ko": "→ 평화 루트 가능성, 모두 살아남음", "en": "→ Peace route possible, everyone survives" }
        },
        {
          "id": "cv_ch9_target_pilgrim",
          "text": { "ko": "Pilgrim Arms의 고용주를 추적한다.", "en": "Trace who hired Pilgrim Arms." },
          "tone": "investigative",
          "preview_hint": { "ko": "→ 배후 해금, 모든 루트에 영향", "en": "→ Unlock who's behind it, affects all routes" }
        }
      ]
    },
    {
      "id": "s06",
