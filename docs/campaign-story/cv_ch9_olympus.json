  "scenes": [
    {
      "id": "s01",
      "type": "narration",
      "background": "kepler_crater",
      "bgm": "fsp_ambient",
      "transition": "fade_slow",
      "lines": [
        { "text": { "ko": "Olympus Mons 정상 회담. CV 입장에서 이것은 함정이었다. 아니면 마지막 기회였다. 정육점은 그것을 알면서 왔다.", "en": "The Olympus Mons summit. From CV's perspective this was a trap. Or a last chance. Butcher came knowing that." } }
      ]
    },
    {
      "id": "s02",
      "type": "dialogue",
      "background": "mcc_25deg_lounge",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "butcher", "emotion": "alert", "effect": "character_enter:butcher:slide_left", "text": { "ko": "Pilgrim Arms가 건물 안에 있어. 4명. 우리를 노리는 게 아니야.", "en": "Pilgrim Arms is in the building. Four of them. They're not targeting us." } },
        { "speaker": "hale", "emotion": "tense", "effect": "character_enter:hale:slide_right", "text": { "ko": "FSP? MCC? 아니면 우리를?", "en": "FSP? MCC? Or us?" } },
        { "speaker": "butcher", "emotion": "calculating", "text": { "ko": "아직 몰라. 지켜봐.", "en": "Don't know yet. Watch." } }
      ]
    },
    {
      "id": "s03",
      "type": "dialogue",
      "background": "mcc_25deg_lounge",
      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "hale", "emotion": "urgent_private", "text": { "ko": "정육점이랑 마지막으로 제대로 얘기할 기회야.", "en": "This is your last real chance to talk with Butcher." } },
        { "speaker": "player", "emotion": "neutral", "text": { "ko": "무슨 얘기를요?", "en": "About what?" } },
        { "speaker": "hale", "emotion": "quiet", "text": { "ko": "그가 진짜 원하는 게 뭔지. 전쟁이 끝나면 어떻게 할 건지.", "en": "What he actually wants. What happens when the war ends." } }
      ]
    },
    {
      "id": "s04",
      "type": "dialogue",
      "background": "mcc_25deg_lounge",
      "bgm": "ambient_melancholy",
      "transition": "cut",
      "lines": [
        { "speaker": "butcher", "emotion": "old_tired", "text": { "ko": "전쟁이 끝나면 나도 끝이야. 그게 맞아.", "en": "When the war ends, I end too. That's how it should be." } },
        { "speaker": "player", "emotion": "surprised", "text": { "ko": "...", "en": "..." } },
        { "speaker": "butcher", "emotion": "flat", "text": { "ko": "신더는 알고 있어. 그래서 다른 길 찾는 거고.", "en": "Cinder knows that. That's why she's looking for another way." } }
      ]
    },
    {
      "id": "s05",
      "type": "narration",
      "background": "mcc_25deg_lounge",
      "bgm": "ambient_melancholy",
      "transition": "cut",
      "lines": [
        { "text": { "ko": "Pilgrim Arms가 움직이기 시작했다. 그들의 표적이 누구인지, 그 대답이 지금 결정해야 할 것을 바꾸었다.", "en": "Pilgrim Arms began to move. Knowing who their target was changed what had to be decided now." } }
      ]
    },
    {
