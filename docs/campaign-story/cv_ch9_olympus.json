      "bgm": "fsp_ambient",
      "transition": "cut",
      "lines": [
        { "speaker": "butcher", "emotion": "final", "text": { "ko": "끝내자.", "en": "Let's end it." } },
        { "speaker": "hale", "emotion": "resolved", "text": { "ko": "어떤 방식으로든.", "en": "In whatever way." } }
